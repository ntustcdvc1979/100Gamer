# 複製成 .env.local。兩個都不填 = 本機模式（BroadcastChannel，分頁之間同步）。

# 遊戲伺服器（主線）。本機開發用 ws://，正式環境一定要 wss://
# —— GitHub Pages 是 HTTPS，瀏覽器會擋掉 ws:// 的 mixed content。
VITE_WS_URL=ws://localhost:8080

# Firebase（備援，可選）。一整行 JSON，注意 key 要加雙引號。
# databaseURL 一定要有，少了會安靜地退回本機模式。
# VITE_FIREBASE_CONFIG={"apiKey":"AIza...","authDomain":"xxx.firebaseapp.com","databaseURL":"https://xxx-default-rtdb.asia-southeast1.firebasedatabase.app","projectId":"xxx","appId":"1:123:web:abc"}
